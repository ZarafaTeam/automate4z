{
  "name": "a4z-monorepo",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest",
