    "@vitest/coverage-v8": "^1.2.1",
    "@vitest/ui": "^1.2.1",
    "depcheck": "^1.4.7",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.5",
    "typescript": "^5.1.0",
    "vitest": "^1.2.1"
  },
  "dependencies": {
    "@zowe/imperative": "^8.20.0",
    "@zowe/secrets-for-zowe-sdk": "^8.18.3",
    "js-yaml": "^4.1.0"
  }
